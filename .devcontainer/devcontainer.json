{
  // GitHub Codespaces：仓库页面 → Code → Codespaces → Create codespace，启动后自动运行演示网关
  "name": "智能家居演示",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 2 },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "智能家居演示", "onAutoForward": "notify" }
  },
  "postStartCommand": "docker compose -f docker-compose.demo.yml up -d --build"
}
