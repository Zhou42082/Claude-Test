# 复制为 .env 后修改
# App 访问网关的令牌，生成方式：python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=change-me
# mock = 演示数据；ha = 接入 Home Assistant；可同时启用：mock,ha
GATEWAY_ADAPTERS=ha
HA_URL=http://localhost:8123
# HA 个人资料 -> 安全 -> 长期访问令牌
HA_TOKEN=
# 远程开锁 PIN。留空则 App 不能开锁（只能上锁）。不要与 GATEWAY_TOKEN 相同
GATEWAY_UNLOCK_PIN=
# 告警记录等数据的保存目录（Docker 镜像中默认 /data，已挂载到 ./data/gateway）
# GATEWAY_DATA_DIR=/data
